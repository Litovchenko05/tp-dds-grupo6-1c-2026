{
  "swagger": "2.0",
  "info": {
    "title": "Sistema Sweet Medical API",
    "description": "Documentación de la API del TP de Desarrollo de Software - 1C 2026",
    "version": "1.0.0"
  },
  "host": "localhost:3000",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "paths": {
    "/healthcheck": {
      "get": {
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/notificaciones/{id}/leida": {
      "put": {
        "tags": [
          "Notificaciones"
        ],
        "summary": "Marcar una notificación como leída",
        "description": "Actualiza el estado de una notificación a leída y registra la fecha y hora de lectura.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID de MongoDB de la notificación a actualizar",
            "example": "6661ee005fedc12a282ac126"
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/notificaciones/": {
      "post": {
        "tags": [
          "Notificaciones"
        ],
        "summary": "Crear una notificación de prueba",
        "description": "Permite forzar la creación de una notificación manualmente (ideal para probar con Postman).",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Datos requeridos para generar la notificación",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "destinatario": {
                  "type": "string",
                  "example": "6661ee005fedc12a282ac126"
                },
                "remitente": {
                  "type": "string",
                  "example": "6661ee005fedc12a282ac127"
                },
                "mensaje": {
                  "type": "string",
                  "example": "El paciente Juan Pérez ha cancelado el turno de las 16:30hs."
                }
              }
            }
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/turnos/": {
      "get": {
        "tags": [
          "Turnos Globales"
        ],
        "summary": "Obtener todos los turnos",
        "description": "Recupera un listado global y paginado de los turnos de la clínica.",
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/turnos/{id}": {
      "get": {
        "tags": [
          "Turnos Globales"
        ],
        "summary": "Obtener un turno por ID",
        "description": "Busca los detalles de un turno específico en el sistema.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID del turno"
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        }
      },
      "post": {
        "tags": [
          "Turnos Globales"
        ],
        "summary": "Solicitar cambio de fecha",
        "description": "Inicia una solicitud de reprogramación para un turno específico a nivel sistema.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID del turno"
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/turnos/{id}/cancelar": {
      "patch": {
        "tags": [
          "Turnos Globales"
        ],
        "summary": "Cancelar un turno globalmente",
        "description": "Cambia el estado del turno a cancelado desde el módulo administrador de turnos.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID del turno a cancelar"
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/turnos/{id}/realizado": {
      "patch": {
        "tags": [
          "Turnos Globales"
        ],
        "summary": "Marcar turno como realizado",
        "description": "Actualiza el estado del turno indicando que la consulta médica finalizó con éxito.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID del turno a finalizar"
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/medicos/": {
      "get": {
        "tags": [
          "Médicos"
        ],
        "summary": "Obtener listado de médicos paginado",
        "description": "Recupera una lista paginada de todos los médicos registrados en el sistema.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Número de página",
            "type": "integer"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Cantidad de resultados por página",
            "type": "integer"
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        }
      },
      "post": {
        "tags": [
          "Médicos"
        ],
        "summary": "Crear un nuevo médico",
        "description": "Da de alta un perfil de médico de forma manual.",
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/medicos/{id}": {
      "get": {
        "tags": [
          "Médicos"
        ],
        "summary": "Obtener médico por ID",
        "description": "Recupera el perfil completo de un médico específico mediante su ID de MongoDB.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID del médico"
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/medicos/{id}/turnos": {
      "get": {
        "tags": [
          "Médicos",
          "Turnos"
        ],
        "summary": "Obtener turnos de un médico",
        "description": "Recupera los turnos asociados a un médico. Permite filtrar por servicio y estado.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID del médico"
          },
          {
            "name": "nombreServicio",
            "in": "query",
            "description": "Filtrar por nombre del servicio (ej: Cardiologia)",
            "required": false,
            "type": "string"
          },
          {
            "name": "estadoTurno",
            "in": "query",
            "description": "Filtrar por estado del turno (ej: DISPONIBLE)",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/medicos/{id}/turnos/{idTurno}": {
      "post": {
        "tags": [
          "Médicos",
          "Turnos"
        ],
        "summary": "Solicitar cambio de fecha de turno",
        "description": "El médico solicita la reprogramación de un turno existente.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID del médico"
          },
          {
            "name": "idTurno",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID del turno"
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        }
      },
      "put": {
        "tags": [
          "Médicos",
          "Turnos"
        ],
        "summary": "Actualizar datos de un turno",
        "description": "Modifica los detalles generales de un turno asignado a este médico.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID del médico"
          },
          {
            "name": "idTurno",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID del turno"
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        }
      },
      "patch": {
        "tags": [
          "Médicos",
          "Turnos"
        ],
        "summary": "Cancelar un turno",
        "description": "El médico cancela un turno específico.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID del médico"
          },
          {
            "name": "idTurno",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID del turno a cancelar"
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/medicos/{id}/turnos/{idTurno}/cambios": {
      "post": {
        "tags": [
          "Médicos",
          "Turnos"
        ],
        "summary": "Registrar un cambio en el turno",
        "description": "Añade un registro al historial de cambios de un turno específico.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID del médico"
          },
          {
            "name": "idTurno",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID del turno"
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/medicos/{id}/disponibilidades": {
      "get": {
        "tags": [
          "Médicos",
          "Disponibilidad"
        ],
        "summary": "Obtener disponibilidades del médico",
        "description": "Lista los horarios y días que el médico tiene configurados como disponibles.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID del médico"
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        }
      },
      "post": {
        "tags": [
          "Médicos",
          "Disponibilidad"
        ],
        "summary": "Crear bloque de disponibilidad",
        "description": "Define un nuevo rango de días y horarios de atención para el médico.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID del médico"
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/medicos/{id}/disponibilidades/{idDisponibilidad}": {
      "put": {
        "tags": [
          "Médicos",
          "Disponibilidad"
        ],
        "summary": "Modificar bloque de disponibilidad",
        "description": "Edita un rango horario existente del médico.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID del médico"
          },
          {
            "name": "idDisponibilidad",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID de la disponibilidad a modificar"
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/medicos/{id}/servicios": {
      "get": {
        "tags": [
          "Médicos",
          "Servicios"
        ],
        "summary": "Obtener servicios del médico",
        "description": "Recupera la lista de servicios médicos que ofrece el profesional.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID del médico"
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        }
      },
      "post": {
        "tags": [
          "Médicos",
          "Servicios"
        ],
        "summary": "Agregar servicio al médico",
        "description": "Vincula un nuevo servicio de atención al perfil del profesional.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID del médico"
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/medicos/{id}/servicios/{nombreServicio}": {
      "put": {
        "tags": [
          "Médicos",
          "Servicios"
        ],
        "summary": "Modificar servicio del médico",
        "description": "Edita las características de un servicio específico brindado por el médico.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID del médico"
          },
          {
            "name": "nombreServicio",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Nombre del servicio actual"
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/medicos/{id}/servicios/{tipoServicio}/{servicioNombre}": {
      "delete": {
        "tags": [
          "Médicos",
          "Servicios"
        ],
        "summary": "Eliminar servicio del médico",
        "description": "Desvincula un servicio médico del perfil del profesional.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID del médico"
          },
          {
            "name": "tipoServicio",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Tipo o categoría del servicio"
          },
          {
            "name": "servicioNombre",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Nombre exacto del servicio a eliminar"
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/medicos/{id}/pacientes/{idPaciente}/historial": {
      "get": {
        "tags": [
          "Médicos",
          "Historial Clínico"
        ],
        "summary": "Ver historial clínico de un paciente",
        "description": "Permite al médico visualizar los antecedentes y el historial médico de un paciente específico.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID del médico"
          },
          {
            "name": "idPaciente",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID del paciente a consultar"
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/pacientes/": {
      "get": {
        "tags": [
          "Pacientes"
        ],
        "summary": "Obtener listado de pacientes paginado",
        "description": "Recupera una lista paginada de todos los pacientes del sistema.",
        "responses": {
          "default": {
            "description": ""
          }
        }
      },
      "post": {
        "tags": [
          "Pacientes"
        ],
        "summary": "Crear un nuevo paciente",
        "description": "Da de alta un perfil de paciente de forma manual.",
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/pacientes/{id}": {
      "get": {
        "tags": [
          "Pacientes"
        ],
        "summary": "Obtener paciente por ID",
        "description": "Recupera el perfil completo de un paciente específico mediante su ID de MongoDB.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID del paciente"
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/pacientes/{id}/turnos/{turnoId}": {
      "patch": {
        "tags": [
          "Pacientes",
          "Turnos"
        ],
        "summary": "Cambiar estado de un turno",
        "description": "Permite al paciente modificar el estado de uno de sus turnos (ej. cancelarlo).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID del paciente"
          },
          {
            "name": "turnoId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID del turno a modificar"
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/pacientes/{id}/historial": {
      "get": {
        "tags": [
          "Pacientes",
          "Historial Clínico"
        ],
        "summary": "Consultar historial clínico propio",
        "description": "Recupera el historial de atenciones médicas y antecedentes del paciente.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID del paciente"
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/usuarios/{id}/notificaciones": {
      "get": {
        "tags": [
          "Notificaciones"
        ],
        "summary": "Obtener notificaciones de un usuario",
        "description": "Recupera el historial de notificaciones (tanto leídas como no leídas) asociadas a un usuario específico.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID de MongoDB del usuario cuyas notificaciones se quieren consultar",
            "example": "6661ee005fedc12a282ac126"
          },
          {
            "name": "leida",
            "in": "query",
            "description": "Filtrar por notificaciones leídas (true) o no leídas (false). Si no se envía, trae todas.",
            "required": false,
            "type": "boolean"
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/auth/registro": {
      "post": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Registrar un nuevo usuario",
        "description": "Registra un paciente o médico en el sistema, creando su cuenta en Keycloak y su perfil en MongoDB.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Datos del usuario a registrar (nombre, username, password, rol, y DNI/Matrícula según corresponda).",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {}
            }
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    }
  }
}