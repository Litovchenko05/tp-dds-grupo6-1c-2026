        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Datos requeridos para generar la notificación",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "destinatario": {
                  "type": "string",
                  "example": "6661ee005fedc12a282ac126"
                },
                "remitente": {
                  "type": "string",
                  "example": "6661ee005fedc12a282ac127"
                },
                "mensaje": {
                  "type": "string",
